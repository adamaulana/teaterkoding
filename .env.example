APP_NAME="Teater Koding"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ============================================================
# AKUN SEEDER (AdminGuruSeeder) — GANTI SEBELUM PRODUKSI
# ============================================================
ADMIN_NAME="Admin Teater Koding"
ADMIN_EMAIL=admin@teaterkoding.test
ADMIN_PASSWORD=ganti-sebelum-produksi
GURU_NAME="Budi Santoso"
GURU_EMAIL=guru@teaterkoding.test
GURU_PASSWORD=ganti-sebelum-produksi

# ============================================================
# SISI SISWA (Fase 5) — lihat config/teater.php
# ============================================================

# Batas percobaan: login siswa per menit per IP, buka misi per menit per siswa.
TEATER_LOGIN_THROTTLE=10
TEATER_UNLOCK_THROTTLE=5

# Jeda minimal antar-submit (detik) & ukuran maksimum kode (byte).
TEATER_SUBMIT_INTERVAL=15
TEATER_MAX_CODE_BYTES=20000

# Aturan main.
TEATER_ENFORCE_ROLES=true
TEATER_REQUIRE_REVIEW=false
TEATER_REQUIRE_SEQUENTIAL=true

# Poin permainan.
TEATER_HINT_PENALTY=5
TEATER_PLAN_BONUS=10
TEATER_FIRST_TRY_BONUS=10

# Papan peringkat siswa & jeda autosave draf (milidetik).
TEATER_SHOW_LEADERBOARD=true
TEATER_DRAFT_AUTOSAVE_MS=1500

# Penilai otomatis:
#   pyodide → penilaian di BROWSER siswa (Fase 6); server tidak menjalankan kode.
#             TIDAK butuh queue worker.
#   fake    → menilai alur UI tanpa menjalankan Python (HANYA local/testing).
#             WAJIB ada worker: `php artisan queue:work` (atau `composer dev`).
#   null    → tidak menilai; status submission tetap "menunggu" SELAMANYA.
# Piston/Docker DIBATALKAN (tidak berjalan di laptop Windows).
#
# Cek kesehatan kapan saja: php artisan teater:diagnosa-penilaian
TEATER_RUNNER=pyodide

# ============================================================
# PENILAIAN DI BROWSER (Pyodide) — Fase 6
# ============================================================
# Versi dikunci; aset disalin oleh `npm run vendor:pyodide` (tanpa CDN).
TEATER_PYODIDE_VERSION=314.0.7
TEATER_PYODIDE_ASSET_PATH=/vendor/pyodide

# Batas waktu (ms): per kelompok setup_code & total seluruh paket.
TEATER_PYODIDE_SETUP_TIMEOUT_MS=3000
TEATER_PYODIDE_TOTAL_TIMEOUT_MS=15000
# Pengali batas waktu saat guru memverifikasi.
TEATER_PYODIDE_VERIFY_MULTIPLIER=2

# Panjang keluaran program (stdout) yang disimpan.
TEATER_PYODIDE_MAX_OUTPUT=2000

# Nonce sekali pakai (menit) & kewajiban verifikasi guru untuk level sumatif.
TEATER_PYODIDE_NONCE_TTL=15
TEATER_PYODIDE_REQUIRE_VERIFICATION=true
